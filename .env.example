# === Gemini ===
# Opción rápida (AI Studio): pega tu API key y listo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opción producción (Vertex AI dentro de Google Cloud): pon 1
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# === Deforestación: Global Forest Watch (Hansen, licencia abierta CC-BY) ===
GFW_API_KEY=
GFW_VERSION=v1.11
LOSS_THRESHOLD_HA=0.1
DEFORESTATION_CUTOFF_YEAR=2020
# === Earth Engine (alternativa; requiere licencia comercial) ===
EE_PROJECT=
HANSEN_ASSET=UMD/hansen/global_forest_change_2023_v1_11
# === Storage ===
GCS_BUCKET=
DATA_DIR=./_data
