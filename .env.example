# === Gemini ===
# Opción rápida (AI Studio): pega tu API key y listo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Opción producción (Vertex AI dentro de Google Cloud): pon 1
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# === Earth Engine (chequeo de deforestación) ===
EE_PROJECT=
HANSEN_ASSET=UMD/hansen/global_forest_change_2023_v1_11
DEFORESTATION_CUTOFF_YEAR=2020
# === Storage ===
GCS_BUCKET=
DATA_DIR=./_data
